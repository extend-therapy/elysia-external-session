{
  "name": "@extend-therapy/elysia-external-session",
  "version": "0.1.5",
  "description": "Elysia External Session",
  "author": "Eli Selkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extend-therapy/elysia-external-session.git"
  },
  "scripts": {
    "build": "rm -rf dist || true && tsc",
    "prepublishOnly": "bun lint:fix && bun test && bun run build",
    "test": "bun test",
    "dev": "tsc --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "up": "bun run scripts/bump.ts",
    "pub": "op run --env-file=.env.op -- bun publish"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "dotenv-cli": "11.0.0",
    "elysia": "1.4.28",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "date-fns": "^4.1.0",
    "elysia": "^1.4.28"
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "files": [
    "dist/**/*",
    "!dist/tests/**",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
