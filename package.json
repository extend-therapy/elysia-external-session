{
  "name": "@extend-therapy/elysia-external-session",
  "version": "2.0.1-beta.1",
  "description": "Elysia External Session",
  "author": "Eli Selkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extend-therapy/elysia-external-session.git"
  },
  "scripts": {
    "build": "rm -rf dist || true && tsc",
    "prepublishOnly": "bun lint:fix && bun run test && bun run build",
    "test": "bun test ./tests ./example",
    "dev": "tsc --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "up": "bun run scripts/bump.ts",
    "pub": "op run --env-file=.env.op -- bun publish"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "date-fns": "^4.4.0",
    "dotenv-cli": "11.0.0",
    "elysia": "2.0.0-beta.6",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "date-fns": "^4.4.0",
    "elysia": ">= 2.0.0-beta.6"
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "files": [
    "dist/**/*",
    "!dist/tests/**",
    "README.md",
    "package.json",
    "LICENSE"
  ]
}
